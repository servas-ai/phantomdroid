{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detectorlab.example/schema/probe-record/v2.json",
  "title": "DetectorLab Probe Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "probe_id",
    "probe_name",
    "category",
    "layer",
    "score",
    "runtime_ms",
    "sample_count",
    "seed_ms",
    "raw"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "probe_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9_]*$"
    },
    "probe_name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "buildprop",
        "integrity",
        "root",
        "emulator",
        "network",
        "identity",
        "runtime",
        "sensors",
        "ui",
        "env"
      ]
    },
    "layer": {
      "enum": ["L0a", "L0b", "L0c", "L0", "L1", "L2", "L3", "L4", "L5", "L6"]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "runtime_ms": {
      "type": "integer",
      "minimum": 0
    },
    "sample_count": {
      "type": "integer",
      "minimum": 1
    },
    "seed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "raw": {
      "type": "object",
      "additionalProperties": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_item"
      }
    },
    "repro": {
      "type": "object",
      "additionalProperties": true
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": ["string", "number", "boolean", "object", "array", "null"]
        }
      }
    }
  }
}
