{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phantomdroid/runner-manifest.schema.json",
  "title": "PhantomDroid orchestrator run manifest (runner.v1)",
  "description": "SPEC §5. config_loader.py validates manifests against this; unknown keys are refused.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_id",
    "container_image_hash",
    "compose_file",
    "seccomp_profile",
    "target_runs"
  ],
  "properties": {
    "schema_version": { "const": "runner.v1" },
    "config_id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
    "created": { "type": "string" },
    "container_image_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{12,64}$" },
    "compose_file": { "type": "string", "minLength": 1 },
    "seccomp_profile": { "type": "string", "minLength": 1 },
    "detector_lab_apk": { "type": "string" },
    "detector_lab_apk_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{12,64}$" },
    "target_runs": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "warmup_seconds": { "type": "integer", "minimum": 0 },
    "probe_timeout_seconds": { "type": "integer", "minimum": 1 },
    "binder_device": { "type": "string" },
    "seed": { "type": "string" },
    "modules": { "type": "object", "description": "informational; not used by runner" }
  }
}
