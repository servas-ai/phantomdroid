<?xml version="1.0" encoding="utf-8"?>
<!--
  SpoofStack LSPosed module manifest.

  The four meta-data tags below are read by LSPosed at module-scan time.
  xposedmodule=true tells LSPosed this APK is a module. xposeddescription
  is shown in the LSPosed Manager UI. xposedminversion gates loading on
  hosts running older LSPosed builds.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="SpoofStack"
        android:icon="@android:drawable/sym_def_app_icon"
        android:hasCode="true"
        android:allowBackup="false">

        <!-- LSPosed metadata -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Pixel-7 spoof overlay for ReDroid 12 — closes ~63 production probes" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />

    </application>

</manifest>
