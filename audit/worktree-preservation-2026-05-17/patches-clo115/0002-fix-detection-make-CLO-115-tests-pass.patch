---
 agents/detection/src/probes/app/IgFamilyDeviceIdHeaderProbe.kt | 3 ++-
 .../com/detectorlab/probes/runtime/ScreenRecordingProbeTest.kt | 2 +-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/agents/detection/src/probes/app/IgFamilyDeviceIdHeaderProbe.kt b/agents/detection/src/probes/app/IgFamilyDeviceIdHeaderProbe.kt
index a2046c2..59c7c03 100644
--- a/agents/detection/src/probes/app/IgFamilyDeviceIdHeaderProbe.kt
+++ b/agents/detection/src/probes/app/IgFamilyDeviceIdHeaderProbe.kt
@@ -151,8 +151,9 @@ class IgFamilyDeviceIdHeaderProbe(
      */
     internal fun parseCaptureFile(json: String): CaptureFile? {
         return try {
+            val sandboxMarker = extractString(json, "sandbox_marker") ?: return null
             CaptureFile(
-                sandboxMarker  = extractString(json, "sandbox_marker") ?: "",
+                sandboxMarker  = sandboxMarker,
                 headerPresent  = extractBoolean(json, "header_present") ?: false,
                 value          = extractString(json, "value"),
                 isValidUuid    = extractBoolean(json, "is_valid_uuid") ?: false,
diff --git a/agents/detection/src/test/kotlin/com/detectorlab/probes/runtime/ScreenRecordingProbeTest.kt b/agents/detection/src/test/kotlin/com/detectorlab/probes/runtime/ScreenRecordingProbeTest.kt
index 9f1e658..27f8cca 100644
--- a/agents/detection/src/test/kotlin/com/detectorlab/probes/runtime/ScreenRecordingProbeTest.kt
+++ b/agents/detection/src/test/kotlin/com/detectorlab/probes/runtime/ScreenRecordingProbeTest.kt
@@ -259,7 +259,7 @@ class ScreenRecordingProbeTest {
     }
 
     @Test
-    fun `api_path includes addScreenRecordingCallback only when sdk >= 35`() = runBlocking {
+    fun `api_path includes addScreenRecordingCallback only when sdk is at least 35`() = runBlocking {
         val a14 = probe.run(ctxWith(sdk = 34)).evidence.first { it.key == "api_path" }.value as String
         val a15 = probe.run(ctxWith(sdk = 35)).evidence.first { it.key == "api_path" }.value as String
         assertFalse(a14.contains("addScreenRecordingCallback"))
