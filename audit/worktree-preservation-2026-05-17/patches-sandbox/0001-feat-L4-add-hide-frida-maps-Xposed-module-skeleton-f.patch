+      - ./sandbox/cell0/vector-conf:/data/adb/modules/vector/conf:rw
+      # Shared workspace source for build reference
+      - type: bind
+        source: ./L4/hide-frida-maps
+        target: /src/L4/hide-frida-maps
+        read_only: true
+
+    environment:
+      - ANDROID_DATA=/data
+      - androidboot.hardware=redroid
+      - androidboot.redroid_net_ndns=1
+      # Disable GApps/Play for clean probe environment
+      - androidboot.redroid_google_play_store=0
+      # ADB over TCP
+      - androidboot.redroid_adb_port=5555
+
+    ports:
