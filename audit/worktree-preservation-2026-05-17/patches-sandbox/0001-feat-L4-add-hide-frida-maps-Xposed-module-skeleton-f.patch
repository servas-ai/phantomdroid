+  # ─── L0a: ReDroid base ───────────────────────────────────────────────────
+  redroid:
+    # Image pinned by digest (amd64). No :latest.
+    # Digest sourced from: docker manifest inspect redroid/redroid:12.0.0_64only-latest
+    image: "redroid/redroid@sha256:e6f799d56b9a9a2bbc6224b5b7a6dc744c9b4d878ac856f27f0c4ec793ef55d3"
+    container_name: clo28-cell0-redroid
+    restart: "no"
+    <<: [*hardening, *network]
+
+    # ReDroid requires binder and ashmem kernel features; expose only what's needed
+    devices:
+      - /dev/binder:/dev/binder
+      - /dev/ashmem:/dev/ashmem
+      - /dev/dri:/dev/dri        # GPU acceleration (optional, graceful fail)
+
+    volumes:
+      # L0b root modules (NeoZygisk + Vector)
+      - ./L0b/magisk:/system/addon.d:ro
+      - ./L0b/neozygisk/modules:/data/adb/modules:rw
+      - ./L0b/vector/modules:/data/adb/modules/vector:rw
+      # L4 hide-frida-maps module APK + config
